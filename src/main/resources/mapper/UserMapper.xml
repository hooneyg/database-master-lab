<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.hooney.lab.database.repository.mybatis.UserMyBatisMapper">

    <resultMap id="userResultMap" type="com.hooney.lab.database.domain.user.UserEntity">
        <id property="id" column="id"/>
        <result property="email" column="email"/>
        <result property="name" column="name"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="modifiedAt" column="modified_at"/>
    </resultMap>

    <select id="findById" resultMap="userResultMap">
        SELECT * FROM USERS WHERE id = #{id}
    </select>

    <select id="findAllActiveUsers" resultMap="userResultMap">
        SELECT * FROM USERS WHERE status = 'ACTIVE'
    </select>

    <insert id="save" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO USERS (email, name, phone_number, status, created_at, modified_at)
        VALUES (#{email}, #{name}, #{phoneNumber}, #{status}, #{createdAt}, #{modifiedAt})
    </insert>

    <!-- [Task 1] MyBatis Collection을 이용한 1:N 단일 조인 매핑 -->
    <resultMap id="userWithPostsResultMap" type="com.hooney.lab.database.domain.user.UserEntity" extends="userResultMap">
        <collection property="posts" ofType="com.hooney.lab.database.domain.post.PostEntity">
            <id property="id" column="post_id"/>
            <result property="title" column="post_title"/>
            <result property="content" column="post_content"/>
            <result property="createdAt" column="post_created_at"/>
        </collection>
    </resultMap>

    <select id="findUserWithPosts" resultMap="userWithPostsResultMap">
        SELECT 
            u.*, 
            p.id as post_id, 
            p.title as post_title, 
            p.content as post_content, 
            p.created_at as post_created_at
        FROM USERS u
        LEFT JOIN POSTS p ON u.id = p.user_id
        WHERE u.id = #{id}
    </select>

</mapper>
